<?xml version="1.0" encoding="utf-16"?>
<!-- RAMOPTI low-latency / competitive profile for NVIDIA Profile Inspector.
     Applies to the Base (global) driver profile. Generated from the in-app QCM:
     objective = minimal latency, VSync off, GPU always max, high-performance
     textures, LOD clamp, threaded optimization on, unlimited shader cache,
     no frame cap.
     NOTE: SettingIDs follow the public NVIDIA Profile Inspector reference. Open
     this file once in nvidiaProfileInspector.exe to confirm every value resolves
     on your driver version before relying on it. -->
<ArrayOfProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Profile>
    <ProfileName>_GLOBAL_DRIVER_PROFILE (Base Profile)</ProfileName>
    <Executeables />
    <Settings>
      <!-- Power management mode = Prefer Maximum Performance (1) -->
      <ProfileSetting>
        <SettingNameInfo>Power management mode</SettingNameInfo>
        <SettingID>274197361</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Maximum pre-rendered frames = 1 (lowest render queue) -->
      <ProfileSetting>
        <SettingNameInfo>Maximum pre-rendered frames</SettingNameInfo>
        <SettingID>8102046</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Low Latency Mode = Ultra (2) -->
      <ProfileSetting>
        <SettingNameInfo>Low Latency Mode</SettingNameInfo>
        <SettingID>277041154</SettingID>
        <SettingValue>2</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Vertical Sync = Force Off (0x08416747) -->
      <ProfileSetting>
        <SettingNameInfo>Vertical Sync</SettingNameInfo>
        <SettingID>11041231</SettingID>
        <SettingValue>138504519</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Texture filtering - Quality = High Performance (22) -->
      <ProfileSetting>
        <SettingNameInfo>Texture filtering - Quality</SettingNameInfo>
        <SettingID>13510289</SettingID>
        <SettingValue>22</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Texture filtering - Anisotropic sample optimization = On (1) -->
      <ProfileSetting>
        <SettingNameInfo>Texture filtering - Anisotropic sample optimization</SettingNameInfo>
        <SettingID>8703344</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Texture filtering - Trilinear optimization = On (1) -->
      <ProfileSetting>
        <SettingNameInfo>Texture filtering - Trilinear optimization</SettingNameInfo>
        <SettingID>6260461</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Texture filtering - Negative LOD bias = Clamp (1) -->
      <ProfileSetting>
        <SettingNameInfo>Texture filtering - Negative LOD bias</SettingNameInfo>
        <SettingID>3066610</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Threaded optimization = On (1) -->
      <ProfileSetting>
        <SettingNameInfo>Threaded optimization</SettingNameInfo>
        <SettingID>20913776</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Shader Cache = On (1) -->
      <ProfileSetting>
        <SettingNameInfo>Shader Cache</SettingNameInfo>
        <SettingID>11306135</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Ambient Occlusion usage = Off (0) — no extra GPU cost from the driver -->
      <ProfileSetting>
        <SettingNameInfo>Ambient Occlusion usage</SettingNameInfo>
        <SettingID>282757977</SettingID>
        <SettingValue>0</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- Ambient Occlusion setting = Off (0) -->
      <ProfileSetting>
        <SettingNameInfo>Ambient Occlusion setting</SettingNameInfo>
        <SettingID>283897668</SettingID>
        <SettingValue>0</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
    </Settings>
  </Profile>
</ArrayOfProfile>
